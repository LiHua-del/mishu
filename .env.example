# 可选：将 VPS 上的端口改成其他未占用端口
MISHU_PORT=8001

# 公网部署时必须设置。访问口令用于打开觅书，SESSION_SECRET 请使用另一段随机长字符串。
MISHU_ACCESS_CODE=
MISHU_SESSION_SECRET=
MISHU_SESSION_DAYS=30
MISHU_SYNC_DAYS=180
# 通过 HTTPS 反向代理访问时设为 1。
MISHU_COOKIE_SECURE=0

# 可在网页设置页填写；也可用环境变量预配置 OpenAI 兼容接口。
AI_API_URL=
AI_API_KEY=
AI_API_MODEL=
AI_TIMEOUT=25

# 联网找书：direct=直接访问各平台搜索页（默认）；auto=有 Brave 密钥时汇总结果；
# brave=强制使用 Brave 汇总，需要填写密钥。
SEARCH_PROVIDER=direct
BRAVE_SEARCH_API_KEY=
SEARCH_COUNTRY=CN
SEARCH_LANG=zh-hans
SEARCH_TIMEOUT=10
